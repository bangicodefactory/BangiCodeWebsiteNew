# Copy to .env.local and fill in values.

# Enable the smoke gallery at /smoke — dev only. Do NOT set in production.
SMOKE_GALLERY=

# WhatsApp CTA — E.164 format without leading + (e.g. 212664571370)
NEXT_PUBLIC_WA_NUMBER=

# Cal.com event slug — format: username/event-slug (e.g. bangicode/30min-discovery)
NEXT_PUBLIC_CAL_EVENT_SLUG=
