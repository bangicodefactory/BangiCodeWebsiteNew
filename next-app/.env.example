# Copy to .env.local and fill in values.

# Enable the smoke gallery at /smoke — dev only. Do NOT set in production.
SMOKE_GALLERY=

# WhatsApp CTA — E.164 format without leading + (e.g. 212664571370)
NEXT_PUBLIC_WA_NUMBER=

# Calendly event link, e.g. https://calendly.com/bangicode/30min
# Copy it from Calendly → Event Types → your event → Share → Copy link.
#
# WITHOUT this, /book shows the email + WhatsApp fallback rather than an empty
# box, so an unconfigured deploy still gives visitors a way to reach you.
#
# NEXT_PUBLIC_ is required — the widget initialises in the browser. That makes
# the value public, which is fine: it is the same link you would put in an
# email signature.
NEXT_PUBLIC_CALENDLY_URL=

# ── CMS / admin (see docs/adr/0003-mysql-backed-cms.md) ──────────────────────
# Required for /admin to work. Without them /admin renders setup instructions
# rather than failing — the public site never depends on these.

# Database. On cPanel these come from MySQL® Databases; the user needs ALL
# PRIVILEGES on the database. Note cPanel prefixes both with your account name,
# e.g. bangspbp_cms and bangspbp_cmsuser.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Seals the admin session cookie (AES-256-GCM). At least 32 characters.
#   openssl rand -base64 48
# Without it /admin denies every request — it fails CLOSED, by design.
ADMIN_SESSION_SECRET=

# Absolute origin. Must be https:// in production: the session cookie is
# Secure, and over plain HTTP the browser discards it and sign-in silently
# does nothing.
SITE_URL=https://bangicode.ma

# Accounts are created from the command line — there is no self-signup:
#   pnpm admin:create   (prompts for email, name and password)
#   pnpm admin:passwd   (resets one)
