# Copy to .env.local and fill in values.

# Enable the smoke gallery at /smoke — dev only. Do NOT set in production.
SMOKE_GALLERY=

# WhatsApp CTA — E.164 format without leading + (e.g. 212664571370)
NEXT_PUBLIC_WA_NUMBER=

# Cal.com event slug — format: username/event-slug (e.g. bangicode/30min-discovery)
NEXT_PUBLIC_CAL_EVENT_SLUG=

# ── CMS / admin (see docs/adr/0002-git-backed-cms.md) ────────────────────────
# All four are required for /admin to work. Without them /admin renders setup
# instructions rather than failing — the public site never depends on these.

# GitHub OAuth app. Callback URL must be exactly:
#   <SITE_URL>/admin/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repository content is committed to, as "owner/name".
GITHUB_REPO=

# Seals the admin session cookie (AES-256-GCM). At least 32 characters.
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional — defaults shown.
# Only ACTIVE members of this GitHub org may sign in.
GITHUB_ORG=bangicodefactory
# Branch commits land on.
GITHUB_BRANCH=main
# Absolute origin; also used to build the OAuth callback URL.
SITE_URL=https://bangicode.ma
# Optional — GitHub REST base. Override for GitHub Enterprise, or to point the
# CMS at a stub during testing. Default: https://api.github.com
GITHUB_API_URL=

# Server-side credential used to COMMIT content. Never sent to the browser and
# never stored in a cookie — sign-in only proves identity (scope: read:org).
# Use a fine-grained personal access token limited to THIS repository with
# Contents: read and write. Rotate on a schedule; it is the only write credential.
GITHUB_TOKEN=
