# Copy to .env.local and fill in values.

# Enable the smoke gallery at /smoke — dev only. Do NOT set in production.
SMOKE_GALLERY=

# WhatsApp CTA — E.164 format without leading + (e.g. 212664548867)
NEXT_PUBLIC_WA_NUMBER=

# Cal.com event slug — format: username/event-slug, e.g. acme/30min
# Must name an event that actually EXISTS on cal.com. A wrong slug does not
# fail loudly: the 404 lands inside the cross-origin iframe, so the visitor
# sees Cal.com's error page framed inside /book. Check yours resolves:
#   curl -o /dev/null -w '%{http_code}\n' https://cal.com/<username>/<event>
# Leave EMPTY to serve the email + WhatsApp fallback instead of a broken widget.
# NOTE: NEXT_PUBLIC_ is baked at BUILD time — changing it needs a redeploy.
NEXT_PUBLIC_CAL_EVENT_SLUG=

# Comma-separated addresses added to every booking made through the site, by
# prefilling Cal.com's "Add guests" question. Use it so a second person is on
# the invite without the visitor needing to add them.
# Only covers bookings made through THIS SITE — a visitor who opens the
# cal.com link directly gets an empty guests field. For every route, make it a
# Collective team event instead, where the second person is a host.
NEXT_PUBLIC_CAL_GUESTS=

# ── CMS / admin (see docs/adr/0003-mysql-backed-cms.md) ──────────────────────
# Required for /admin to work. Without them /admin renders setup instructions
# rather than failing — the public site never depends on these.

# Database. On cPanel these come from MySQL® Databases; the user needs ALL
# PRIVILEGES on the database. Note cPanel prefixes both with your account name,
# e.g. bangspbp_cms and bangspbp_cmsuser.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Seals the admin session cookie (AES-256-GCM). At least 32 characters.
#   openssl rand -base64 48
# Without it /admin denies every request — it fails CLOSED, by design.
ADMIN_SESSION_SECRET=

# Absolute origin. Must be https:// in production: the session cookie is
# Secure, and over plain HTTP the browser discards it and sign-in silently
# does nothing.
SITE_URL=https://bangicode.ma

# Accounts are created from the command line — there is no self-signup:
#   pnpm admin:create   (prompts for email, name and password)
#   pnpm admin:passwd   (resets one)
