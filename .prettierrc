{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "plugins": ["prettier-plugin-tailwindcss"],
  "$schema": "https://json.schemastore.org/prettierrc",
  "$comment": "prettier-plugin-tailwindcss is in bangicodecurrent/devDependencies — run prettier from within bangicodecurrent/ (CI and lint-staged both do this via 'defaults: run: working-directory: ./bangicodecurrent' and 'cd bangicodecurrent && pnpm lint-staged')"
}
